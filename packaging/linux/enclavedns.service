[Unit]
Description=EnclaveDNS client: DNS through EnclaveDNS, and .eth sites in the browser
Documentation=https://github.com/EnclaveHost/enclavedns-client
Wants=network-online.target nss-lookup.target
After=network-online.target
Before=nss-lookup.target

[Service]
ExecStart=/usr/bin/enclavedns run
User=enclavedns
Group=enclavedns
# the .eth CA's key lives here (mode 0700, this service's user only)
StateDirectory=enclavedns
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=1
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
